{
  "extends": "next/core-web-vitals",
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "next/navigation",
            "importNames": ["useRouter"],
            "message": "Please use useRouter from /import-bar/baz/ instead."
          },
          {
            "name": "next/router",
            "importNames": ["useRouter"],
            "message": "Please use useRouter from /nextjs-toploader/app/ instead."
          }
        ]
      }
    ]
  }
}

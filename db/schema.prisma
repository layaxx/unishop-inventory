// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

// --------------------------------------

model User {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  name           String?
  email          String   @unique
  hashedPassword String?
  role           String   @default("USER")

  tokens              Token[]
  sessions            Session[]
  AuditLogStocktaking AuditLogStocktaking[]
}

model Session {
  id                 Int       @id @default(autoincrement())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime?
  handle             String    @unique
  hashedSessionToken String?
  antiCSRFToken      String?
  publicData         String?
  privateData        String?

  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}

model Token {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  hashedToken String
  type        String
  // See note below about TokenType enum
  // type        TokenType
  expiresAt   DateTime
  sentTo      String

  user   User @relation(fields: [userId], references: [id])
  userId Int

  @@unique([hashedToken, type])
}

// NOTE: It's highly recommended to use an enum for the token type
//       but enums only work in Postgres.
//       See: https://blitzjs.com/docs/database-overview#switch-to-postgre-sql
// enum TokenType {
//   RESET_PASSWORD
// }
/// INVENTORY MANAGEMENT SCHEMA (Normalized Variant Model)

model Location {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stockLevels    StockLevel[]
  movementsFrom  Movement[]       @relation("MovementFrom")
  movementsTo    Movement[]       @relation("MovementTo")
  InventoryEntry InventoryEntry[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  variants         ProductVariant[]
  productModifiers ProductModifierType[]
}

/// ModifierType defines *what kind* of modifier (e.g., Color, Size)
model ProductModifierType {
  id        Int      @id @default(autoincrement())
  name      String // e.g. "Color"
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ProductModifierValue[]
}

/// ModifierValue defines each possible value of a modifier (e.g., "Red", "Black")
model ProductModifierValue {
  id             Int                 @id @default(autoincrement())
  value          String
  modifierType   ProductModifierType @relation(fields: [modifierTypeId], references: [id])
  modifierTypeId Int
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  order          Int                 @default(autoincrement())

  ProductVariant ProductVariant[]
}

/// ProductVariant represents a concrete SKU (e.g. "T-Shirt – Black – M")
model ProductVariant {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stockLevels    StockLevel[]
  movements      Movement[]
  modifierValues ProductModifierValue[]
  InventoryEntry InventoryEntry[]
}

model Movement {
  id        Int          @id @default(autoincrement())
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  type      MovementType
  quantity  Int

  from   Location? @relation("MovementFrom", fields: [fromId], references: [id])
  fromId Int?
  to     Location? @relation("MovementTo", fields: [toId], references: [id])
  toId   Int?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId Int

  MovementBatch   MovementBatch? @relation(fields: [movementBatchId], references: [id])
  movementBatchId Int?
}

model MovementBatch {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reason String

  movements Movement[]
}

model StockLevel {
  id         Int            @id @default(autoincrement())
  location   Location       @relation(fields: [locationId], references: [id])
  locationId Int
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  Int
  quantity   Int            @default(0)
  updatedAt  DateTime       @updatedAt

  @@unique([locationId, variantId])
}

enum MovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
}

model InventoryEntry {
  id          Int            @id @default(autoincrement())
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   Int
  location    Location       @relation(fields: [locationId], references: [id])
  locationId  Int
  description String?
  quantity    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AuditLogStocktaking {
  id         Int      @id @default(autoincrement())
  locationId Int
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  success    Boolean
  pdfReport  Bytes?
  createdAt  DateTime @default(now())
  PDF        PDF?     @relation(fields: [pDFId], references: [id])
  pDFId      Int?
}

model PDF {
  id        Int                   @id @default(autoincrement())
  data      Bytes
  createdAt DateTime              @default(now())
  audits    AuditLogStocktaking[]
}
